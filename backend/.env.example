# ==============================================================================
# HMS Platform Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="HMS Platform"
VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://hms_user:hms_password@localhost:5432/hms_db"

# Redis Cache & Token Blacklist
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="replace_with_a_secure_random_64_character_hex_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Field-Level Symmetric Encryption (Fernet AES-256 for PII & DPDP Act compliance)
# Generate in python with: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
ENCRYPTION_KEY="replace_with_a_valid_fernet_base64_encoded_32_byte_key="

# ABDM (Ayushman Bharat Digital Mission) Sandbox Credentials
ABDM_BASE_URL="https://dev.abdm.gov.in/gateway"
ABDM_CLIENT_ID="your_abdm_client_id"
ABDM_CLIENT_SECRET="your_abdm_client_secret"

# Webhook Callback URLs (Public IP/Domain or ngrok URL for sandbox)
CALLBACK_BASE_URL="http://localhost:8000"

# CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

