# ==============================================================================
# HMS Platform Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="HMS Platform"
VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://hms_user:hms_password@localhost:5432/hms_db"

# Redis Cache & Token Blacklist
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="replace_with_a_secure_random_64_character_hex_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Field encryption and cloud adapter selection
ENCRYPTION_KEY="replace_with_the_legacy_fernet_key_for_existing_rows"
ENCRYPTION_MASTER_KEY="replace_with_a_random_32_byte_or_stronger_secret"
ENCRYPTION_KEY_VERSION="1"
CLOUD_PROVIDER="SUPABASE_FREE"
SUPABASE_PRIVATE_BUCKET="clinical-records"
AWS_KMS_KEY_ID=""
AWS_S3_BUCKET=""

# ABDM v3 Strategy / Adapter Configuration
# Mode: MOCK (deterministic simulation) | SANDBOX (NHA dev/sbx) | PRODUCTION (NHA live)
ABDM_ENV="MOCK"
ABDM_GATEWAY_URL="https://dev.abdm.gov.in"
ABDM_ABHA_URL="https://abhasbx.abdm.gov.in/abha/api/v3"
ABDM_X_CM_ID="sbx"
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_BRIDGE_ID=""
HFR_FACILITY_ID=""
ABDM_HIP_ID=""
ABDM_HIU_ID=""
ABDM_WEBHOOK_SECRET=""

# Webhook Callback URLs (Public HTTPS domain registered on NHA Sandbox Bridge)
ABDM_CALLBACK_BASE_URL="https://your-hms-domain.example.com"

# CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

