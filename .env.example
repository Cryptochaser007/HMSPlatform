# ==============================================================================
# HMS Platform Stage 2 Free-Tier & Cloud Migration Environment Configuration
# ==============================================================================
# Architecture:
# - Frontend: Vercel Free Tier (React 18 + Vite + Tailwind CSS)
# - Backend:  Render Free Web Service (FastAPI + Python 3.12)
# - Database: Supabase Free Tier (PostgreSQL 16 + Transaction Pooler port 6543)
# - Cache:    Upstash Redis Free Tier (TLS rediss://)
# - Storage:  Supabase Storage (Free) -> Migratable to AWS S3 (ap-south-1)
# - KMS/KEK:  EnvKEKAdapter (Free)   -> Migratable to AWS KMS (ap-south-1)
# ==============================================================================

# ── Application Settings ──────────────────────────────────────────────────────
APP_NAME="HMS Platform"
VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# ── Cloud Provider & Portability Layer ────────────────────────────────────────
# Options: FREE_TIER (Supabase Storage + EnvKEK) | AWS (S3 + KMS in ap-south-1)
CLOUD_PROVIDER="FREE_TIER"

# ── Database (Supabase PostgreSQL with PgBouncer / Port 6543) ─────────────────
# Use port 6543 for transaction pooling compatibility with statement_cache_size=0
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL="postgresql+asyncpg://postgres.your-project-ref:your-strong-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require"

# ── Redis Cache & State (Upstash Free Tier TLS) ───────────────────────────────
# Upstash Redis endpoint with TLS (rediss://)
# Format: rediss://default:[UPSTASH_PASSWORD]@[UPSTASH_ENDPOINT].upstash.io:6379
REDIS_URL="rediss://default:your-upstash-token@your-upstash-host.upstash.io:6379"

# ── JWT Authentication (DISHA / CERT-In WASA Compliant) ───────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY="generate-a-secure-random-64-character-hex-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Field-Level Encryption & Key Hierarchy (DPDP / DISHA Standards) ───────────
# Legacy Fernet key for reading backward-compatible rows
ENCRYPTION_KEY="generate-with-Fernet-generate-key-32bytes-base64="
# AES-256-GCM Master Key Encryption Key (KEK) secret for envelope encryption
ENCRYPTION_MASTER_KEY="generate-a-random-32-byte-or-stronger-master-secret"
ENCRYPTION_KEY_VERSION="1"

# ── Object Storage: Supabase Free Tier ────────────────────────────────────────
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_PRIVATE_BUCKET="clinical-records"

# ── Future AWS ap-south-1 Migration (When CLOUD_PROVIDER="AWS") ───────────────
AWS_REGION="ap-south-1"
AWS_KMS_KEY_ID=""
AWS_S3_BUCKET=""

# ── ABDM v3 Sandbox Strategy Configuration ────────────────────────────────────
# Mode: MOCK (deterministic dry-run) | SANDBOX (NHA SBX) | PRODUCTION (NHA Live)
ABDM_ENV="MOCK"
ABDM_GATEWAY_URL="https://dev.abdm.gov.in"
ABDM_ABHA_URL="https://abhasbx.abdm.gov.in/abha/api/v3"
ABDM_X_CM_ID="sbx"
ABDM_CLIENT_ID="your-nha-sandbox-client-id"
ABDM_CLIENT_SECRET="your-nha-sandbox-client-secret"
ABDM_BRIDGE_ID="your-nha-bridge-id"
HFR_FACILITY_ID="your-facility-hfr-id"
ABDM_HIP_ID="your-hip-id"
ABDM_HIU_ID="your-hiu-id"
ABDM_WEBHOOK_SECRET="your-gateway-webhook-secret"

# Public HTTPS Callback URL registered with NHA Gateway Bridge
# Must point to your Render Web Service deployment
ABDM_CALLBACK_BASE_URL="https://hms-backend.onrender.com"

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Allowed origins (Vercel production URL, preview URLs, local dev)
CORS_ORIGINS='["https://your-hms-frontend.vercel.app", "http://localhost:3000"]'

# ── Frontend Specific (Set in Vercel Environment Variables) ───────────────────
# VITE_API_URL="/api/v1"  # Uses Vercel proxy rewrite
# OR for direct cross-origin calls:
# VITE_API_URL="https://hms-backend.onrender.com/api/v1"
